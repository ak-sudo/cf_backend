# ---- Groq (free tier, no credit card) ----
# Create a free key at https://console.groq.com/keys (starts with gsk_)
GROQ_API_KEY=
# Must accept images. On Groq, qwen/qwen3.8-27b does; openai/gpt-oss-* are text-only.
GROQ_MODEL_ID=qwen/qwen3.8-27b
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=2048
GROQ_TIMEOUT_SECONDS=45
# Retries (with exponential backoff) for free-tier rate limits
GROQ_RETRIES=2
GROQ_RETRY_DELAY_SECONDS=3

# ---- Service ----
AI_SERVICE_ENV=development
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
# Shared secret; the Node backend sends it as X-Internal-Api-Key. Required when AI_SERVICE_ENV=production.
# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
AI_SERVICE_API_KEY=

# ---- Image ingestion guardrails ----
IMAGE_ALLOWED_HOSTS=res.cloudinary.com
MAX_IMAGE_BYTES=8388608
MAX_IMAGE_DIMENSION=1568
MAX_CONCURRENT_ANALYSES=2
