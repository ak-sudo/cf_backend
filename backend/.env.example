# CivicFlow Environment Configuration Template
NODE_ENV=development
PORT=8080

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/civicflow

# Redis & Queue Configuration
REDIS_URL=redis://localhost:6379

# JWT Security
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_characters
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=info

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=civicflow-dev
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gemma 4 AI Inference Microservice
AI_SERVICE_URL=http://localhost:8000/api/v1/classify
GEMMA_MODEL_NAME=gemma-4-civic-vision
GEMMA_API_KEY=AQ.Ab8RN6KSkSA5o8-yC5Z4lJdJXSFMKb6vrpi33jtnyPS4oGeuwA

# Firebase Admin (must be the same project the frontend signs in with)
FIREBASE_PROJECT_ID=civicflow-60df2
# Optional: full service-account JSON on one line (enables revocation checks)
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Shared secret sent to the Python AI service as X-Internal-Api-Key (must match ai-service/.env)
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_MS=120000
